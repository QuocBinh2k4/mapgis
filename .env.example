DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
PORT=3000
ROUTING_PROVIDER=valhalla
VALHALLA_URL=https://valhalla1.openstreetmap.de/
# Khi triển khai, đặt tên miền website để nhận diện ứng dụng với dịch vụ.
ROUTING_CLIENT_ID=mapgis-vietnam-educational

# Google Identity Services: OAuth Client ID loại Web application.
GOOGLE_CLIENT_ID=
APP_ORIGIN=http://localhost:3000
# Trên Vercel, đặt APP_ORIGIN=https://mapgis-eight.vercel.app
# Danh sách email quản trị ban đầu, cách nhau bằng dấu phẩy.
# Chỉ cấp quyền khi tạo tài khoản lần đầu với email Gmail/Google Workspace đã xác minh.
ADMIN_EMAILS=quocbinhvt2004@gmail.com
# Token Blob store Public dùng cho ảnh quản trị. Cần cấu hình khi chạy local.
BLOB_READ_WRITE_TOKEN=
# Token của Blob store Private riêng cho ảnh người dùng gửi.
PRIVATE_BLOB_READ_WRITE_TOKEN=
